# Copia este archivo como .env.local y completa tus llaves de Wompi
# Dashboard de Wompi → Desarrolladores → Llaves del API / Secretos para integración técnica

# Llave pública (pub_test_... para pruebas, pub_prod_... para cobrar de verdad)
WOMPI_PUBLIC_KEY=pub_test_xxx

# Secreto de integridad (firma el monto del pago para que no se pueda alterar)
WOMPI_INTEGRITY_SECRET=test_integrity_xxx

# Secreto de eventos (verifica que los avisos de pago vienen de Wompi)
WOMPI_EVENTS_SECRET=test_events_xxx

# URL pública del sitio (sin / final). En producción: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
