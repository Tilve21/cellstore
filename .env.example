# Copia este archivo como .env.local y completa tus claves de Stripe
# https://dashboard.stripe.com/apikeys

# Clave secreta (sk_test_... para pruebas, sk_live_... para cobrar de verdad)
STRIPE_SECRET_KEY=sk_test_xxx

# Secreto del webhook (whsec_...). En local lo da `stripe listen`, en producción el Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# URL pública del sitio (sin / final). En producción: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Moneda (debe coincidir con los precios del catálogo en src/data/products.ts)
NEXT_PUBLIC_CURRENCY=usd
NEXT_PUBLIC_LOCALE=es-US

# Países permitidos para envío (ISO alpha-2, separados por coma)
SHIPPING_COUNTRIES=US,MX,CO,CL,PE,AR,EC,ES
